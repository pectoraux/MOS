{
  "name": "marketingos",
  "version": "0.1.0",
  "private": true,
  "description": "MarketingOS — provider-independent, evidence-driven multi-tenant marketing operating system (modular monolith). MKT-001: platform and modular-monolith foundation.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "arch:check": "node tools/arch-check/run.ts",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:architecture": "node --test \"tests/architecture/**/*.test.ts\"",
    "test:integration": "node --test \"tests/integration/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:architecture && npm run test:integration",
    "dev:api": "node --watch src/entrypoints/api.ts",
    "dev:worker": "node --watch src/entrypoints/worker.ts"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@eslint/js": "9.39.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
