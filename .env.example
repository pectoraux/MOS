# MarketingOS platform configuration (MKT-001).
# Copy to .env and export before starting api/worker, or set these directly.
# All variables are validated at startup; invalid config fails fast.

# PostgreSQL connection (system of record). Required for api and worker.
MOS_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/marketingos

# HTTP control-plane API listener.
MOS_HTTP_HOST=127.0.0.1
MOS_HTTP_PORT=8080

# Environment label: dev | test | prod
MOS_ENV=dev

# Structured logging: debug | info | warn | error
MOS_LOG_LEVEL=info

# Object storage abstraction: memory | fs
MOS_OBJECT_STORE=fs
MOS_OBJECT_STORE_DIR=./var/objects

# Bearer token accepted by the platform HTTP authenticator.
# If unset, authenticated routes fail closed (401).
MOS_INTERNAL_API_TOKEN=

# Worker tuning
MOS_WORKER_ID=
MOS_WORKER_POLL_INTERVAL_MS=500
MOS_WORKER_BATCH_SIZE=5
MOS_JOB_MAX_ATTEMPTS=5
MOS_JOB_RETRY_BACKOFF_BASE_MS=1000

# Maximum accepted JSON request body size in bytes.
MOS_HTTP_MAX_BODY_BYTES=1048576

# Integration-test only: directory with libicu60 shared libraries for the
# embedded PostgreSQL test server (downloaded automatically when needed).
# MOS_TEST_ICU_LIB_DIR=
